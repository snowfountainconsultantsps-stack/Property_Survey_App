# Copy this to .env.local (already git-ignored) to override locally.
# Both vars are optional — config.js falls back to the deployed Render
# backend if neither is set, so `expo start`, EAS preview, and EAS
# production all work with zero configuration.

# Origin only — no /api suffix, no trailing slash.
# Only set this if you want the app to hit a backend running on your own
# machine instead of the deployed one (must be your LAN IP, not localhost,
# since a physical device/simulator can't reach your machine's localhost).
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.23:5000

# DEV | PREVIEW | PRODUCTION — gates a couple of dev-only conveniences
# (e.g. prefilled test coordinates in property/[id]/edit.js).
# EXPO_PUBLIC_ENV=DEV
