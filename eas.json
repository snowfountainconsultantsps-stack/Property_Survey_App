{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ENV": "DEV"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_ENV": "PREVIEW",
        "EXPO_PUBLIC_API_BASE_URL": "https://property-survey-backend.onrender.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_ENV": "PRODUCTION",
        "EXPO_PUBLIC_API_BASE_URL": "https://property-survey-backend.onrender.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
